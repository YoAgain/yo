<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Yo</string>
	<key>NSCameraUsageDescription</key>
	<string>Yo uses the camera so you can send photos and videos to friends and scan your recovery key to sign in.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Yo uses Face ID to verify your identity before showing your recovery key.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Yo saves your recovery key to Photos when you choose, and saves photos and videos you send when Keep Sent Photos is on.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Montserrat-Bold.ttf</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
