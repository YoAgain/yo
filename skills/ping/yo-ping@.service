[Unit]
Description=Yo PING echo (%i)
# The clock set first: a device signature with a clock off after a reboot is refused (401).
After=network.target time-sync.target

[Service]
Type=simple
DynamicUser=yes
Environment=YO_BIN=/opt/yo/yo YO_STATE=%S/yo-ping-%i
# YO_HUB, YO_HUB_KEYS, YO_TRUST_ROOTS, YO_ZK_PARAMS (app/cli/README.md)
EnvironmentFile=/etc/yo-ping-%i.env
ExecStart=/usr/bin/python3 -I -B /opt/yo/skills/ping/ping.py --quiet-for YOGPT,PINGTEST
StateDirectory=yo-ping-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
# 3: this device is gone for good (replaced by another, name released); 4: nothing registered in the directory
# (a skill never registers: `yo register NAME` once, by hand). Both stay stopped. Every other code restarts, 5 (a
# 401: a clock off, a hub restarting) too.
RestartPreventExitStatus=3 4
NoNewPrivileges=yes
PrivateTmp=yes
# Other users see no process of it: sender ids and probe tokens are in the arguments of `yo`.
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
