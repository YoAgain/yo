#!/usr/bin/env python3
"""dev/loc_history: the README's chart, the repository's lines of code per day since its first commit.

  every day with a commit ──▶ its last commit on main
        ▼
  git grep -c '\\S' <rev>: non-empty lines per file
        ▼
  every code file (CODE) the repository tracked that day, tests and fuzz targets included
        ▼
  dev/loc-history.svg (the lines over the days, then today's lines per part as bars, readable dark and light),
  embedded in README.md; redrawn by hand with commits that change the code (no workflow):  dev/loc_history

Sections: count · chart · main
"""
import subprocess
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "dev" / "loc-history.svg"     # (argv[0] overrides)
CODE = (".rs", ".swift", ".kt", ".py", ".sh")


# === count ========================================================================================

def git(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True, check=True).stdout


def counted(path):
    """every code file of the repository counts, tests and fuzz targets too"""
    return path.endswith(CODE)


AREAS = (("core", ("core/",)), ("hub", ("hub/",)), ("iOS app", ("app/ios/",)), ("YoGPT", ("app/yogpt/",)),
         ("tests + fuzz", ("tests/", "fuzz/")), ("dev", ("dev/",)))


def lines_at(rev, by_area=False):
    """the non-empty lines of every counted file at one commit (by_area: {area: lines} for AREAS, the rest "other")"""
    out = subprocess.run(["git", "-C", str(ROOT), "grep", "-c", "-I", "-E", r"\S", rev],
                         capture_output=True, text=True).stdout
    total, areas = 0, {}
    for row in out.splitlines():
        name, _, n = row.rpartition(":")
        path = name.split(":", 1)[1] if ":" in name else name
        if n.isdigit() and counted(path):
            total += int(n)
            area = next((a for a, tops in AREAS if path.startswith(tops)), "other")
            areas[area] = areas.get(area, 0) + int(n)
    return areas if by_area else total


def days():
    """[(day, last commit of that day on main)], oldest first"""
    last = {}
    for row in git("log", "--first-parent", "HEAD", "--format=%ad %H", "--date=short").splitlines():
        day, rev = row.split()
        last.setdefault(day, rev)                  # newest first, so the first seen is the day's last
    return sorted(last.items())


# === chart ========================================================================================

def svg(points, areas=None):
    """a plain chart: x = day, y = count; lines of code an amethyst area, the newest value labelled; under it one bar per
    area (today)"""
    w, h, left, right, top, bottom = 760, 240, 56, 70, 20, 36
    rows = [(a, (areas or {}).get(a, 0)) for a, _ in AREAS] + ([("other", areas["other"])] if (areas or {}).get("other") else [])
    rows.sort(key=lambda r: -r[1])
    bar_h, gap = 16, 6
    bars_h = len(rows) * (bar_h + gap) + 48 if areas else 0
    total_h = h + bars_h
    most = max([n for _, n in rows] + [1])
    scale = (w - left - right - 150) / most
    subs = []
    bars, legend = [], []
    for i, (name, n) in enumerate(rows):
        y0 = h + 24 + i * (bar_h + gap)
        bars.append(f'<text x="{left + 84}" y="{y0 + 12}" text-anchor="end" class="t">{name}</text>')
        if True:
            bars.append(f'<rect x="{left + 92}" y="{y0}" width="{max(1, n * scale):.1f}" height="{bar_h}" rx="3" class="b"/>')
        bars.append(f'<text x="{left + 98 + n * scale:.1f}" y="{y0 + 12}" class="t">{n / 1000:.1f}k</text>')
    if legend:
        y0, x0 = h + 24 + len(rows) * (bar_h + gap) + 10, left + 92
        for sub, m, c in legend:
            label = f"{sub} {m / 1000:.0f}k"
            bars.append(f'<rect x="{x0}" y="{y0 - 9}" width="10" height="10" rx="2" fill="{c}"/>'
                        f'<text x="{x0 + 14}" y="{y0}" class="t">{label}</text>')
            x0 += 24 + 6.2 * len(label)
    bars = "".join(bars)
    d0 = date.fromisoformat(points[0][0])
    span = max(1, (date.fromisoformat(points[-1][0]) - d0).days)
    vals = sorted(v for _, v in points)
    cap = vals[-2] * 1.25 if len(vals) > 2 and vals[-1] > 1.6 * vals[-2] else vals[-1]   # one outlier day is clipped
    top_v = cap * 1.1 or 1
    step = 10 ** (len(str(int(top_v))) - 1)
    step = step // 2 if top_v / step < 4 else step * 2 if top_v / step > 8 else step

    def x(day): return left + (date.fromisoformat(day) - d0).days / span * (w - left - right)
    def y(v): return h - bottom - min(v, top_v) / top_v * (h - top - bottom)

    grid = []
    v = 0
    while v <= top_v:
        grid.append(f'<line x1="{left}" x2="{w - right}" y1="{y(v):.1f}" y2="{y(v):.1f}" class="g"/>'
                    f'<text x="{left - 8}" y="{y(v) + 4:.1f}" text-anchor="end" class="t">{v // 1000}k</text>')
        v += step
    ticks = []
    for i, (day, _) in enumerate(points):
        near_end = i < len(points) - 1 and x(points[-1][0]) - x(day) < 40
        few = len(points) <= 15                    # a young repository: every day labelled
        if i == 0 or i == len(points) - 1 or ((few or day.endswith(("-01", "-10", "-20"))) and not near_end):
            ticks.append(f'<text x="{x(day):.1f}" y="{h - 14}" text-anchor="middle" class="t">{day[5:]}</text>')
    path = " ".join(f"{'M' if i == 0 else 'L'}{x(d):.1f},{y(v):.1f}" for i, (d, v) in enumerate(points))
    area = f"{path} L{x(points[-1][0]):.1f},{y(0):.1f} L{x(points[0][0]):.1f},{y(0):.1f} Z"
    last_d, last_v = points[-1]
    key = (f'<rect x="{left + 8}" y="{top}" width="12" height="10" rx="2" fill="#9b59b666" stroke="#9b59b6"/>'
           f'<text x="{left + 26}" y="{top + 9}" class="t">lines of code</text>')
    clipped = "".join(f'<text x="{x(d):.1f}" y="{top - 6}" text-anchor="middle" class="t">{v // 1000}k ▲</text>'
                      for d, v in points if v > top_v)
    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {total_h}" width="{w}" height="{total_h}" font-family="ui-sans-serif,system-ui,sans-serif" font-size="11">
<style>.g{{stroke:#8884;stroke-width:1}}.t{{fill:#888}}.l{{fill:none;stroke:#9b59b6;stroke-width:2.5}}.a{{fill:#9b59b640}}.v{{fill:#9b59b6;font-weight:600;font-size:13px}}.b{{fill:#9b59b6aa}}</style>
{"".join(grid)}{"".join(ticks)}
<path d="{area}" class="a"/><path d="{path}" class="l"/>
{clipped}<circle cx="{x(last_d):.1f}" cy="{y(last_v):.1f}" r="3.5" fill="#9b59b6"/>
<text x="{x(last_d) + 8:.1f}" y="{y(last_v) + 4:.1f}" class="v">{last_v / 1000:.0f}k</text>
{key}
{bars}
</svg>
'''


# === main =========================================================================================

def main(argv):
    points = [(day, lines_at(rev)) for day, rev in days()]
    points = [p for p in points if p[1]]
    out = Path(argv[0]) if argv else OUT
    out.write_text(svg(points, lines_at("HEAD", by_area=True)))
    for day, n in points[-5:]:
        print(f"{day} {n} lines")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
