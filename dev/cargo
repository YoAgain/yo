#!/bin/sh
# Runs cargo in the pinned Rust image, so nothing but Docker is needed on the machine.
# Docker runs rootless here: root in the container is the user outside.
# The registry lives in ~/.cache/yo-cargo, the build output in ./target.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$HOME/.cache/yo-cargo"
image=yo-rust:1.99.1
docker image inspect "$image" >/dev/null 2>&1 || docker build -q -t "$image" "$root/dev" >/dev/null
# YO_ENV="A=1 B=2" passes variables into the container.
env_flags=""
for pair in $YO_ENV; do env_flags="$env_flags -e $pair"; done
exec docker run --rm -i --network host \
  -e CARGO_HOME=/cargo -e RUSTUP_AUTO_INSTALL=0 -e CARGO_TERM_COLOR=never \
  $env_flags \
  -v "$HOME/.cache/yo-cargo:/cargo" \
  -v "$root:/yo" -w "/yo${YO_CWD:+/$YO_CWD}" \
  "$image" cargo "$@"
