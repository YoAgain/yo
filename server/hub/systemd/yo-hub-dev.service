[Unit]
Description=Yo dev hub
After=network-online.target yo-hub-dev.socket
Requires=yo-hub-dev.socket
Wants=network-online.target
ConditionPathExists=/opt/yo/yo-hub

[Service]
ExecStart=/opt/yo/yo-hub-dev
EnvironmentFile=/etc/yo/hub-dev.env
LoadCredential=apns.p8:/etc/yo/apns.p8
Environment=YO_DB=/var/lib/yo-dev/yo-hub.sqlite YO_LISTEN=127.0.0.1:8090
Restart=always
RestartSec=2
LimitNOFILE=65536

DynamicUser=yes
StateDirectory=yo-dev
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
LoadCredential=fcm.json:/etc/yo/fcm-service-account.json
Environment=YO_FCM_SERVICE_ACCOUNT_FILE=%d/fcm.json
LoadCredential=hub-key:/etc/yo/hub-key-dev
Environment=YO_HUB_KEY_FILE=/run/credentials/yo-hub-dev.service/hub-key
MemoryHigh=384M
MemoryMax=512M
LoadCredential=server-cert:/etc/yo/server-cert-dev
Environment=YO_SERVER_CERT_FILE=/run/credentials/yo-hub-dev.service/server-cert
LoadCredential=zk-params:/etc/yo/zk-params-dev
Environment=YO_ZK_PARAMS_FILE=/run/credentials/yo-hub-dev.service/zk-params
# The OHTTP key in use (spec 4.1), key id 1; its spare (id 2) stays offline until a rotation.
LoadCredential=ohttp-key:/etc/yo/ohttp-key-dev
Environment=YO_OHTTP_KEY_FILE=/run/credentials/yo-hub-dev.service/ohttp-key

[Install]
WantedBy=multi-user.target
