<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Yo Dev's notification service in the Simulator (project.yml): the app's state in Yo Dev's App Group. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.justyo.ios.dev</string>
	</array>
</dict>
</plist>
