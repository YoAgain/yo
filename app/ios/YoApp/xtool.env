# Read by omarchy-apple-dev's ship.sh (here and in CI): the App Store signature carries the app's own entitlements
# (the passkey domain) on top of what the profile grants.
export ASC_ENTITLEMENTS_PATH=${ASC_ENTITLEMENTS_PATH:-$PWD/Entitlements.plist}
# The icons to choose from in Appearance, as Xcode's ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES: actool's partial
# Info.plist replaces the whole CFBundleIcons of ours, so on the Mac (CI) its CFBundleAlternateIcons comes from these
# sets in Resources/Assets.xcassets; the loose PNGs and Info.plist's own entries serve the Linux dev builds (no actool).
export ALTERNATE_APP_ICONS=${ALTERNATE_APP_ICONS:-"Negative Original OG2014 Lilac2015"}
