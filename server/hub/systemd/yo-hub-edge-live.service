[Unit]
Description=Yo live edge hub: takes, hands out and pushes Yos here, forwards the rest to Falkenstein (yo #15)
After=network-online.target yo-corrosion-live.service yo-hub-relay.service
Wants=network-online.target yo-corrosion-live.service
ConditionPathExists=/opt/yo/yo-hub

# Delivery (POST /v1/inbox/{user}, GET /v1/inbox, POST /v1/inbox/ack, those inside OHTTP) against the live Corrosion;
# every other request through the relay (127.0.0.1:8094) over the mesh to Falkenstein's live hub (its host,
# hub.justyo.app or justyo.app, picks it there). Tunnel yo's hub.justyo.app and apex routes point at 127.0.0.1:8080.
# The environment: /etc/yo/hub-edge-live.env (the live hub's, YO_HUB_NAME, YO_HUB_INDEX, YO_PEER_TOKEN).
[Service]
ExecStart=/opt/yo/yo-hub
EnvironmentFile=/etc/yo/hub-edge-live.env
Environment=YO_DB=/var/lib/yo-edge-live/yo-hub.sqlite YO_LISTEN=127.0.0.1:8080 YO_EDGE_UPSTREAM=http://127.0.0.1:8094
Environment=YO_MESH_HOST=hub.justyo.app YO_EDGE_OFF_FILE=/run/yo-edge-live/off
Environment=YO_CORROSION_API=http://127.0.0.1:8098 YO_CORROSION_DB=/var/lib/yo-corrosion-live/corrosion.db
LoadCredential=apns.p8:/etc/yo/apns.p8
LoadCredential=fcm.json:/etc/yo/fcm-service-account.json
LoadCredential=hub-key:/etc/yo/hub-key
LoadCredential=ohttp-key:/etc/yo/ohttp-key
LoadCredential=server-cert:/etc/yo/server-cert
LoadCredential=zk-params:/etc/yo/zk-params
# The other hubs over the mesh (a device's envelopes they hold), with the relay's node certificate.
LoadCredential=mesh.toml:/etc/yo/mesh.toml
LoadCredential=ca.crt:/etc/yo/mesh/ca.crt
LoadCredential=node.crt:/etc/yo/mesh/node.crt
LoadCredential=node.key:/etc/yo/mesh/node.key
Environment=YO_MESH_PEERS=%d/mesh.toml
Environment=YO_APNS_KEY_FILE=%d/apns.p8 YO_FCM_SERVICE_ACCOUNT_FILE=%d/fcm.json YO_HUB_KEY_FILE=%d/hub-key
Environment=YO_OHTTP_KEY_FILE=%d/ohttp-key YO_SERVER_CERT_FILE=%d/server-cert YO_ZK_PARAMS_FILE=%d/zk-params
Restart=always
RestartSec=2
TimeoutStopSec=40
LimitNOFILE=65536
MemoryHigh=128M
MemoryMax=192M

DynamicUser=yes
SupplementaryGroups=yo-corro
StateDirectory=yo-edge-live
# TRANSITION(#15): remove the override directory when the edge relay retires.
RuntimeDirectory=yo-edge-live
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/yo-corrosion-live
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
