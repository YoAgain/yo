<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Let the system use ProMotion on iPhone. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The version people see, set by hand for each App Store release (1.0.0, 1.0.1, 1.1.0 …); the build number is the
	     build's timestamp (CI), which YO_MIN_APP compares. -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<!-- English, and German for Siri and Shortcuts: de.lproj/AppShortcuts.strings has the App Shortcuts' phrases in
	     German (YoShortcuts.swift). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<!-- Silent pushes (content-available, the hub's non-urgent deliveries) wake the app for one short inbox sync
	     (AppDelegate in Push.swift). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- iPhone and iPad (1, 2), one adaptive app; on a Mac with Apple silicon it runs as "Designed for iPad". The
	     extensions take the app's family (ship.sh). -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Yo</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>Negative</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>IconNegative</string>
				</array>
			</dict>
			<key>Original</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>IconOriginal</string>
				</array>
			</dict>
			<key>OG2014</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>IconOG2014</string>
				</array>
			</dict>
			<key>Lilac2015</key>
			<dict>
				<key>CFBundleIconFiles</key>
				<array>
					<string>IconLilac2015</string>
				</array>
			</dict>
		</dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon</string>
			</array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.justyo.ios.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yo</string>
			</array>
		</dict>
	</array>
	<!-- Siri routes these messaging requests to the app delegate, and only does in an app with multiple scenes: without
	     the manifest it looks for an Intents extension, finds none and answers that the app doesn't support this. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>INIntentsSupported</key>
	<array>
		<string>INSendMessageIntent</string>
		<string>INSearchForMessagesIntent</string>
		<string>INSetMessageAttributeIntent</string>
	</array>
	<!-- Export compliance, Apple's meaning: false = no encryption needing documentation. Yo encrypts with libsignal
	     (standard algorithms only, mass market); for that Apple asks documentation only for the French store, and Yo
	     is not sold in France. Should France come back: ANSSI declaration into App Store Connect, then true plus
	     ITSEncryptionExportComplianceCode (true without a code fails every upload with ITMS-90592). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Yo uses the camera so you can send photos and videos to friends and scan your recovery key to sign in.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Yo records sound with the videos you send.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Yo uses Face ID to verify your identity before showing your recovery key.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Yo saves your recovery key to Photos when you choose.</string>
	<!-- Siri asks before handling Yos. -->
	<key>NSSiriUsageDescription</key>
	<string>Siri sends your Yos and reads who sent you one, also in CarPlay.</string>
	<!-- "Sent Yo! to Mia" in the Dynamic Island after a Yo from outside the app (YoActivity.swift). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Messaging activities the app can handle for Siri. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
		<string>INSearchForMessagesIntent</string>
		<string>INSetMessageAttributeIntent</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Montserrat-Bold.ttf</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<!-- iPhone: portrait, as always. iPad: every orientation and no UIRequiresFullScreen, so Split View, Stage
	     Manager and a Mac window can size it freely (the list adapts, List/FriendList.swift). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
