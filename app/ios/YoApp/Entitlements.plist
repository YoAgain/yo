<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the app claims on top of its provisioning profile (dev/sign.sh): the domain its passkeys belong to (it serves
     /.well-known/apple-app-site-association naming this app; the hub does, YO_APPLE_APP_IDS); the website's, whose
     links justyo.co/NAME open the app (Invite.swift; its association file names Yo and Yo Dev); and push, communication notifications,
     Siri messaging and CarPlay as a communication app (Apple's managed capability: Yos read out and answered by Siri
     in the car, and CarPlay's own screen: the list, a tap sends Yo). Push and optional App Attest use the environments granted by the profile: development for Yo Dev,
     production for TestFlight and the App Store. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:justyo.app</string>
		<string>applinks:justyo.co</string>
	</array>
	<key>com.apple.developer.carplay-communication</key>
	<true/>
	<key>com.apple.developer.siri</key>
	<true/>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
