[Unit]
Description=Yo STATUS numbers

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/yo/status-collect.py
RuntimeDirectory=yo-status
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
TemporaryFileSystem=/var/lib/private:ro
BindReadOnlyPaths=/var/lib/private/yo
InaccessiblePaths=-/etc/yo
RestrictAddressFamilies=AF_UNIX
