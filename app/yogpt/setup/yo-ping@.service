[Unit]
Description=Yo PING echo (%i)
After=network.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/yo-ping-%i.env
ExecStart=/opt/yo/yo-gpt --account PING=${HUB},/var/lib/yo-ping-%i,PING --echo PING $PINS
StateDirectory=yo-ping-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
