[Unit]
Description=Yo mesh (heartbeat to the other servers, mutual TLS)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/yo/yo-mesh
# Never gives up: it comes back on its own whenever it can (a peer or the tailnet down is no reason to stop).
StartLimitIntervalSec=0

# Its port on the server's tailnet address; it binds before tailscaled is up (net.ipv4.ip_nonlocal_bind=1) and
# retries on its own. The node's certificate and key as credentials: root's files, read by systemd for it.
[Service]
# /etc/yo is root's: its settings come in as a credential like the certificates.
ExecStart=/opt/yo/yo-mesh %d/mesh.toml
LoadCredential=mesh.toml:/etc/yo/mesh.toml
LoadCredential=ca.crt:/etc/yo/mesh/ca.crt
LoadCredential=node.crt:/etc/yo/mesh/node.crt
LoadCredential=node.key:/etc/yo/mesh/node.key
Restart=always
RestartSec=2

DynamicUser=yes
# status.json, read by the admin (another user): the directory world-readable, the file made 0644 by yo-mesh; nothing
# secret in it.
RuntimeDirectory=yo-mesh
RuntimeDirectoryMode=0755
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# The tailnet only: Tailscale's addresses (100.64.0.0/10) and nothing else.
IPAddressDeny=any
IPAddressAllow=100.64.0.0/10
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
