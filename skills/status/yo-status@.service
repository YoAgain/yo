[Unit]
Description=Yo STATUS report (%i)
After=network.target

# Root without its powers but one: CAP_DAC_READ_SEARCH, to read the live hub's database (it belongs to the hub's
# throwaway user) and the admin's config. Nothing else of /var/lib/private is there; nothing outside its own
# directories is writable; only the local hub is reachable.
[Service]
Type=simple
Environment=YO_BIN=/opt/yo/yo YO_STATE=%S/yo-status-%i
Environment=STATUS_CONFIG=/var/lib/yo-admin/status-bot.json STATUS_HUB_DB=/var/lib/private/yo/yo-hub.sqlite
# YO_HUB, YO_HUB_KEYS, YO_TRUST_ROOTS (app/cli/README.md); STATUS_TO_USER: the only user it sends to (a user id)
EnvironmentFile=/etc/yo-status-%i.env
ExecStart=/usr/bin/python3 -I -B /opt/yo/skills/status/status.py
StateDirectory=yo-status-%i
StateDirectoryMode=0700
# last.json for the admin page: the numbers of the last report, no names
RuntimeDirectory=yo-status-%i
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=10
# 3: the hub no longer knows this device; 4: nothing registered (yocli.py); 5: no STATUS_TO_USER. All stay stopped.
RestartPreventExitStatus=3 4 5
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
TemporaryFileSystem=/var/lib/private:ro
BindReadOnlyPaths=/var/lib/private/yo
InaccessiblePaths=-/etc/yo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
