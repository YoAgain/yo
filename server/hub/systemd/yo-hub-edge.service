[Unit]
Description=Yo dev edge hub: takes, hands out and pushes Yos here, forwards the rest to Falkenstein (yo #15)
After=network-online.target yo-corrosion.service yo-hub-relay.service
Wants=network-online.target yo-corrosion.service
ConditionPathExists=/opt/yo/yo-hub

# Delivery (POST /v1/inbox/{user}, GET /v1/inbox, POST /v1/inbox/ack, those inside OHTTP) against Corrosion; every
# other request through the relay (127.0.0.1:8094) over the mesh to Falkenstein's dev hub. cloudflared-yo-dev points
# at 127.0.0.1:8090. The environment: /etc/yo/hub-edge.env (YO_HUB_NAME, YO_HUB_INDEX, push and OHTTP as the dev hub's).
[Service]
ExecStart=/opt/yo/yo-hub
EnvironmentFile=/etc/yo/hub-edge.env
Environment=YO_DB=/var/lib/yo-edge/yo-hub.sqlite YO_LISTEN=127.0.0.1:8090 YO_EDGE_UPSTREAM=http://127.0.0.1:8094
Environment=YO_CORROSION_API=http://127.0.0.1:8097 YO_CORROSION_DB=/var/lib/yo-corrosion/corrosion.db
LoadCredential=apns.p8:/etc/yo/apns.p8
LoadCredential=fcm.json:/etc/yo/fcm-service-account.json
LoadCredential=hub-key:/etc/yo/hub-key-dev
LoadCredential=ohttp-key:/etc/yo/ohttp-key-dev
LoadCredential=server-cert:/etc/yo/server-cert-dev
LoadCredential=zk-params:/etc/yo/zk-params-dev
Environment=YO_APNS_KEY_FILE=%d/apns.p8 YO_FCM_SERVICE_ACCOUNT_FILE=%d/fcm.json YO_HUB_KEY_FILE=%d/hub-key
Environment=YO_OHTTP_KEY_FILE=%d/ohttp-key YO_SERVER_CERT_FILE=%d/server-cert YO_ZK_PARAMS_FILE=%d/zk-params
Restart=always
RestartSec=2
TimeoutStopSec=40
LimitNOFILE=65536
MemoryHigh=96M
MemoryMax=160M

DynamicUser=yes
SupplementaryGroups=yo-corro
StateDirectory=yo-edge
ReadWritePaths=/var/lib/yo-corrosion
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
