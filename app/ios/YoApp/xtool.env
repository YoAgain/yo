# Read by omarchy-apple-dev's ship.sh (here and in CI): the App Store signature carries the app's own entitlements
# (the passkey domain) on top of what the profile grants.
export ASC_ENTITLEMENTS_PATH=${ASC_ENTITLEMENTS_PATH:-$PWD/Entitlements.plist}
# The icons: Resources/AppIcon.icon and the alternates Negative.icon and Original.icon (Icon Composer, Liquid Glass),
# which omarchy-apple-dev's compile-app-icon.sh hands to actool with --alternate-app-icon for these names.
export ALTERNATE_APP_ICONS=${ALTERNATE_APP_ICONS:-"Negative Original"}
