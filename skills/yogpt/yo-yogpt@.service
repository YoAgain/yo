[Unit]
Description=Yo YoGPT (%i)
After=network.target

[Service]
Type=simple
DynamicUser=yes
Environment=YO_BIN=/opt/yo/yo YO_STATE=%S/yo-yogpt-%i YO_USERNAME=YOGPT
# YO_HUB, YO_HUB_KEYS, YO_TRUST_ROOTS, YO_ZK_PARAMS (app/cli/README.md)
EnvironmentFile=/etc/yo-yogpt-%i.env
ExecStart=/usr/bin/python3 -I -B /opt/yo/skills/yogpt/yogpt.py --replies /opt/yo/replies --quiet-for PING,PINGTEST
StateDirectory=yo-yogpt-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
# 3: the hub no longer knows this device (replaced, name released, hub reset): stays stopped.
RestartPreventExitStatus=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
