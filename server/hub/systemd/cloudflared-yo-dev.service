[Unit]
Description=Cloudflare Tunnel for the Yo dev hub
After=network-online.target
Wants=network-online.target

# Beside the yo tunnel's cloudflared (its metrics on 20241): a tunnel of its own, only dev.justyo.app. On the edges the
# drop-in relay.conf binds it to yo-hub-relay, so a dead relay takes its connector out of Cloudflare's rotation.
[Service]
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:20242 --grace-period 30s run --token-file %d/token
LoadCredential=token:/etc/cloudflared/yo-dev.token
Restart=always
RestartSec=2
TimeoutStopSec=40
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
