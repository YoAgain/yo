[Unit]
Description=Yo PINGTEST round-trip probe (%i)
After=network.target

[Service]
Type=simple
DynamicUser=yes
Environment=YO_BIN=/opt/yo/yo YO_STATE=%S/yo-pingtest-%i YO_USERNAME=PINGTEST
# YO_HUB, YO_HUB_KEYS, YO_TRUST_ROOTS, YO_ZK_PARAMS (app/cli/README.md)
EnvironmentFile=/etc/yo-pingtest-%i.env
ExecStart=/usr/bin/python3 -I -B /opt/yo/skills/pingtest/pingtest.py
StateDirectory=yo-pingtest-%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
# 3: the hub no longer knows this device (replaced, name released, hub reset): stays stopped.
RestartPreventExitStatus=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
